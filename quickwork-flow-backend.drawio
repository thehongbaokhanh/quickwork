<mxfile host="app.diagrams.net" modified="2026-07-21T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram name="Flow Backend QuickWork" id="quickwork-backend-flow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="QuickWork - Luồng backend dạng bảng" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Tóm tắt từ docs/architecture.md và docs/user-flows.md. Route runtime lấy backend/cmd/api/main.go làm nguồn chính." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="80" y="72" width="1680" height="32" as="geometry" />
        </mxCell>
        <mxCell id="startup" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;1. Luồng khởi động backend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Bước&lt;/td&gt;&lt;td&gt;Module / code&lt;/td&gt;&lt;td&gt;Việc xảy ra&lt;/td&gt;&lt;td&gt;Ghi chú&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;config.LoadConfig()&lt;/td&gt;&lt;td&gt;Đọc .env hoặc biến môi trường&lt;/td&gt;&lt;td&gt;APP_PORT mặc định 8080&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;config.InitCloudinary()&lt;/td&gt;&lt;td&gt;Khởi tạo upload cloud nếu có cấu hình&lt;/td&gt;&lt;td&gt;Không làm đổi route&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;redis.Init + jwt.SetSecret&lt;/td&gt;&lt;td&gt;Chuẩn bị Redis blacklist token và JWT secret&lt;/td&gt;&lt;td&gt;Dùng cho login, logout, API protected&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;database.InitMySQL&lt;/td&gt;&lt;td&gt;Kết nối MySQL bằng GORM, pool và ping&lt;/td&gt;&lt;td&gt;Lỗi DB làm backend không start&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;database.Migrate + Seed&lt;/td&gt;&lt;td&gt;AutoMigrate model và seed demo idempotent&lt;/td&gt;&lt;td&gt;Chạy mỗi lần backend start&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;Repositories / Services / Handlers&lt;/td&gt;&lt;td&gt;Dựng dependency xử lý request&lt;/td&gt;&lt;td&gt;Một số handler query DB trực tiếp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;Fiber app + CORS + /uploads&lt;/td&gt;&lt;td&gt;Nhận request từ Nuxt và serve file upload&lt;/td&gt;&lt;td&gt;CORS cho frontend local&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;/api/v1 routes + Swagger + Listen&lt;/td&gt;&lt;td&gt;Kích hoạt route runtime và lắng nghe port&lt;/td&gt;&lt;td&gt;Route chỉ active nếu main.go đăng ký&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="850" height="345" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;2. Luồng request runtime&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Thứ tự&lt;/td&gt;&lt;td&gt;Lớp&lt;/td&gt;&lt;td&gt;Vai trò&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Nuxt / Vue page&lt;/td&gt;&lt;td&gt;Người dùng thao tác trên UI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;frontend/app/services/*&lt;/td&gt;&lt;td&gt;Gọi service frontend phù hợp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;api.ts / apiClient&lt;/td&gt;&lt;td&gt;Gắn baseURL, JSON header, Authorization Bearer token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;HTTP /api/v1&lt;/td&gt;&lt;td&gt;Request đi vào backend Fiber&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Route group&lt;/td&gt;&lt;td&gt;Chọn route public, protected, student, enterprise hoặc admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;Middleware&lt;/td&gt;&lt;td&gt;Auth, role, KYB/GPKD hoặc public rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;Handler&lt;/td&gt;&lt;td&gt;Validate input, gọi service/repository hoặc query DB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;GORM -&gt; MySQL / Redis&lt;/td&gt;&lt;td&gt;Đọc ghi dữ liệu, blacklist token, preload quan hệ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;JSON response&lt;/td&gt;&lt;td&gt;Trả success/error cho frontend&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#93c5fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="125" width="850" height="345" as="geometry" />
        </mxCell>
        <mxCell id="routes" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;3. Route group đang hoạt động&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Group&lt;/td&gt;&lt;td&gt;Middleware&lt;/td&gt;&lt;td&gt;Chức năng chính&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/api/v1/auth&lt;/td&gt;&lt;td&gt;Public&lt;/td&gt;&lt;td&gt;Đăng ký, đăng nhập, logout, upload GPKD, Google auth&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/api/v1/jobs&lt;/td&gt;&lt;td&gt;Public&lt;/td&gt;&lt;td&gt;Danh sách/chi tiết việc làm APPROVED và slots &amp;gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/api/v1/profile&lt;/td&gt;&lt;td&gt;AuthMiddleware&lt;/td&gt;&lt;td&gt;Profile/test endpoint đã đăng nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/api/v1/student&lt;/td&gt;&lt;td&gt;Auth + Role STUDENT&lt;/td&gt;&lt;td&gt;job-actions, applied jobs, favorite jobs, apply, favorite&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/api/v1/enterprise&lt;/td&gt;&lt;td&gt;Auth + Role ENTERPRISE + EnterpriseApproved&lt;/td&gt;&lt;td&gt;Quản lý tin, ứng viên, lịch phỏng vấn, kết quả phỏng vấn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/api/v1/admin&lt;/td&gt;&lt;td&gt;Auth + Role ADMIN&lt;/td&gt;&lt;td&gt;Người dùng, sinh viên, doanh nghiệp, job review, dashboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;/uploads/* và /swagger/*&lt;/td&gt;&lt;td&gt;Public runtime route&lt;/td&gt;&lt;td&gt;File upload local và Swagger UI&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="850" height="315" as="geometry" />
        </mxCell>
        <mxCell id="middleware" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;4. Middleware và điều kiện chặn&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Lớp bảo vệ&lt;/td&gt;&lt;td&gt;Điều kiện qua&lt;/td&gt;&lt;td&gt;Khi lỗi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AuthMiddleware&lt;/td&gt;&lt;td&gt;Có Authorization Bearer; token không nằm trong Redis blacklist; JWT hợp lệ; user còn ACTIVE&lt;/td&gt;&lt;td&gt;401/403 khi token sai, user INACTIVE/BANNED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RoleMiddleware&lt;/td&gt;&lt;td&gt;Role trong c.Locals khớp role được phép&lt;/td&gt;&lt;td&gt;Chặn dùng sai khu vực STUDENT/ENTERPRISE/ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EnterpriseApprovedMiddleware&lt;/td&gt;&lt;td&gt;Enterprise profile KYB APPROVED và GPKD URL không rỗng&lt;/td&gt;&lt;td&gt;Doanh nghiệp chưa duyệt không vào được API enterprise&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Public job rule&lt;/td&gt;&lt;td&gt;Chỉ trả job APPROVED và slots &amp;gt; 0&lt;/td&gt;&lt;td&gt;Ẩn DRAFT/PENDING/REJECTED/CLOSED khỏi trang công khai&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#93c5fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="500" width="850" height="315" as="geometry" />
        </mxCell>
        <mxCell id="roles" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;5. Role và luồng vào hệ thống&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Người dùng&lt;/td&gt;&lt;td&gt;Role&lt;/td&gt;&lt;td&gt;Có thể làm&lt;/td&gt;&lt;td&gt;Giới hạn quan trọng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Khách truy cập&lt;/td&gt;&lt;td&gt;không có&lt;/td&gt;&lt;td&gt;Xem /, /student, /jobs; đăng ký; Google login&lt;/td&gt;&lt;td&gt;Không ứng tuyển/lưu việc; không vào protected route&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sinh viên&lt;/td&gt;&lt;td&gt;STUDENT&lt;/td&gt;&lt;td&gt;Sau login về /; apply/favorite; xem việc đã ứng tuyển/yêu thích&lt;/td&gt;&lt;td&gt;Chỉ thao tác job APPROVED và slots &amp;gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Doanh nghiệp&lt;/td&gt;&lt;td&gt;ENTERPRISE&lt;/td&gt;&lt;td&gt;Sau KYB duyệt về /enterprise; quản lý tin/ứng viên/phỏng vấn&lt;/td&gt;&lt;td&gt;Không login hoàn tất nếu KYB chưa duyệt hoặc thiếu GPKD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Admin&lt;/td&gt;&lt;td&gt;ADMIN&lt;/td&gt;&lt;td&gt;Sau login về /admin/dashboard; quản lý user/KYB/job review&lt;/td&gt;&lt;td&gt;Admin account được bảo vệ, không đổi status admin&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="845" width="850" height="285" as="geometry" />
        </mxCell>
        <mxCell id="workflows" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;6. Luồng nghiệp vụ chính&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Mảng&lt;/td&gt;&lt;td&gt;Trạng thái / luồng&lt;/td&gt;&lt;td&gt;Ý nghĩa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Trạng thái user&lt;/td&gt;&lt;td&gt;ACTIVE / INACTIVE / BANNED&lt;/td&gt;&lt;td&gt;Chỉ ACTIVE được login và dùng protected API&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KYB doanh nghiệp&lt;/td&gt;&lt;td&gt;PENDING -&gt; APPROVED hoặc REJECTED&lt;/td&gt;&lt;td&gt;APPROVED + GPKD mới vào được khu doanh nghiệp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Trạng thái tin&lt;/td&gt;&lt;td&gt;DRAFT -&gt; PENDING -&gt; APPROVED / REJECTED; APPROVED -&gt; CLOSED; CLOSED -&gt; DRAFT&lt;/td&gt;&lt;td&gt;Public chỉ thấy APPROVED còn slots&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Đơn ứng tuyển&lt;/td&gt;&lt;td&gt;APPLIED -&gt; ACCEPTED hoặc REJECTED&lt;/td&gt;&lt;td&gt;Doanh nghiệp sở hữu job mới thấy và xử lý đơn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Kết quả phỏng vấn&lt;/td&gt;&lt;td&gt;ACCEPTED + lịch -&gt; HIRED / REJECTED / NO_SHOW&lt;/td&gt;&lt;td&gt;HIRED trừ slots; slots = 0 thì job CLOSED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#93c5fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="845" width="850" height="285" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;7. File cần đọc khi sửa luồng backend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Khu vực&lt;/td&gt;&lt;td&gt;File chính&lt;/td&gt;&lt;td&gt;Dùng để kiểm tra&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Entry point/runtime&lt;/td&gt;&lt;td&gt;backend/cmd/api/main.go&lt;/td&gt;&lt;td&gt;Nguồn quyết định backend đăng ký route nào&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Auth&lt;/td&gt;&lt;td&gt;routes/auth.go; handlers/auth_handler.go; services/auth_service.go&lt;/td&gt;&lt;td&gt;Login, register, logout, Google auth&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Middleware&lt;/td&gt;&lt;td&gt;internal/middlewares/*.go&lt;/td&gt;&lt;td&gt;Auth token, role, enterprise KYB/GPKD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Student actions&lt;/td&gt;&lt;td&gt;routes/student_routes.go; handlers/student_job_handler.go&lt;/td&gt;&lt;td&gt;Apply, favorite, job-actions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Enterprise jobs/applications&lt;/td&gt;&lt;td&gt;routes/enterprise_routes.go; handlers/enterprise_job_handler.go&lt;/td&gt;&lt;td&gt;Jobs, applications, interview, interview result&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Admin&lt;/td&gt;&lt;td&gt;routes/admin_routes.go; handlers/admin_handler.go&lt;/td&gt;&lt;td&gt;Users, students, enterprises, jobs, dashboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Frontend mapping&lt;/td&gt;&lt;td&gt;frontend/app/services/*.ts; api.ts&lt;/td&gt;&lt;td&gt;Request frontend đi tới API nào&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1160" width="850" height="335" as="geometry" />
        </mxCell>
        <mxCell id="debug" value="&lt;b&gt;&lt;font style='font-size:18px;color:#0f172a'&gt;8. Ghi nhớ khi debug nhanh&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:12px;color:#334155'&gt;&lt;tr style='background:#e0f2fe;color:#075985;font-weight:bold'&gt;&lt;td&gt;Dấu hiệu&lt;/td&gt;&lt;td&gt;Kiểm tra&lt;/td&gt;&lt;td&gt;Ghi chú&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;API 404&lt;/td&gt;&lt;td&gt;Đối chiếu backend/cmd/api/main.go&lt;/td&gt;&lt;td&gt;Có route file chưa chắc đã active nếu main.go không đăng ký&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;401 / 403&lt;/td&gt;&lt;td&gt;Kiểm tra token, Redis blacklist, user status, role, KYB/GPKD&lt;/td&gt;&lt;td&gt;Đặc biệt enterprise phải APPROVED và có GPKD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DB start fail&lt;/td&gt;&lt;td&gt;Kiểm tra .env, MySQL, migration, seed&lt;/td&gt;&lt;td&gt;Migrate/Seed chạy mỗi lần backend start&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;File upload 404&lt;/td&gt;&lt;td&gt;Mở qua backend origin /uploads&lt;/td&gt;&lt;td&gt;Không mở relative /uploads bằng origin Nuxt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Job không hiển thị&lt;/td&gt;&lt;td&gt;Kiểm tra status APPROVED và slots &amp;gt; 0&lt;/td&gt;&lt;td&gt;CLOSED/REJECTED/PENDING không public&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#93c5fd;strokeWidth=2;shadow=1;spacing=14;align=left;verticalAlign=top;overflow=fill;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="1160" width="850" height="335" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
