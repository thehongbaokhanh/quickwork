# Copy this file to .env.production on the VPS, then replace every CHANGE_ME value.
# Never commit .env.production or real credentials.

COMPOSE_PROJECT_NAME=quickwork
TZ=Asia/Ho_Chi_Minh

# Public URLs and host TLS files
DOMAIN=jobs.example.com
NUXT_PUBLIC_API_BASE=https://jobs.example.com/api/v1
NUXT_PUBLIC_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
TLS_CERT_PATH=/etc/letsencrypt/live/jobs.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/jobs.example.com/privkey.pem

# Backend
APP_NAME=QuickWork
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET
ADMIN_IP_ALLOWLIST=CHANGE_ME_ADMIN_PUBLIC_IP/32
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_JWT_SECRET
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=720
DB_SEED_ENABLED=false
AUTH_COOKIE_SECURE=true
AUTH_EXPOSE_TOKENS=false
CORS_ALLOWED_ORIGINS=https://jobs.example.com

# MySQL
MYSQL_DATABASE=quickwork
MYSQL_USER=quickwork
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# RabbitMQ
MQ_ENABLED=true
RABBITMQ_DEFAULT_USER=quickwork
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
# Keep this password synchronized with RABBITMQ_DEFAULT_PASS. URL-encode special characters.
RABBITMQ_URL=amqp://quickwork:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
RABBITMQ_EXCHANGE=quickwork.events
RABBITMQ_QUEUE=quickwork.notifications
RABBITMQ_ROUTING_KEY=notification.create
RABBITMQ_PREFETCH=20

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobs.example.com/auth/google/callback

# Cloudinary (required in production; URL-encode special characters)
CLOUDINARY_URL=cloudinary://CHANGE_ME_API_KEY:CHANGE_ME_API_SECRET@CHANGE_ME_CLOUD_NAME

# Upload malware scanning (required in production; ClamAV remains private)
UPLOAD_MALWARE_SCAN_REQUIRED=true
CLAMAV_ADDRESS=clamav:3310

# AI job matching (optional; deterministic matching remains available without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
JOB_MATCH_CANDIDATE_LIMIT=20
JOB_MATCH_CACHE_TTL_MINUTES=45
JOB_MATCH_AI_TIMEOUT_SECONDS=12

# Encrypted off-site backups. Secret files must be mode 600 and stay outside Git.
RESTIC_REPOSITORY=s3:s3.example.com/CHANGE_ME_BUCKET/quickwork
RESTIC_PASSWORD_FILE=./secrets/restic_password.txt
AWS_CREDENTIALS_FILE=./secrets/aws_credentials
BACKUP_INTERVAL_SECONDS=86400
