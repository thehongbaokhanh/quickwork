# Local-only development values for `docker compose`.
# Copy to .env. These credentials must never be reused in production.

COMPOSE_PROJECT_NAME=quickwork
TZ=Asia/Ho_Chi_Minh

# Browser requests stay on the current origin. This works on localhost and on
# the random HTTPS hostname generated by Cloudflare Quick Tunnel.
NUXT_PUBLIC_API_BASE=/api/v1
# Nitro server-side requests use the Docker service hostname instead.
NUXT_API_BASE_INTERNAL=http://backend:8080/api/v1
# Nitro proxies browser-facing /api and /uploads routes to the private backend.
NUXT_API_PROXY_TARGET=http://backend:8080
NUXT_PUBLIC_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

APP_NAME=QuickWork
ADMIN_SECRET=quickwork_local_admin
JWT_SECRET=quickwork_local_jwt_change_me
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=720
DB_SEED_ENABLED=true

MYSQL_DATABASE=quickwork
MYSQL_USER=quickwork
MYSQL_PASSWORD=quickwork_dev
MYSQL_ROOT_PASSWORD=quickwork_root_dev

REDIS_PASSWORD=quickwork_dev

MQ_ENABLED=true
RABBITMQ_DEFAULT_USER=quickwork
RABBITMQ_DEFAULT_PASS=quickwork_dev
RABBITMQ_URL=amqp://quickwork:quickwork_dev@rabbitmq:5672/
RABBITMQ_EXCHANGE=quickwork.events
RABBITMQ_QUEUE=quickwork.notifications
RABBITMQ_ROUTING_KEY=notification.create
RABBITMQ_PREFETCH=20

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

CLOUDINARY_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
JOB_MATCH_CANDIDATE_LIMIT=20
JOB_MATCH_CACHE_TTL_MINUTES=45
JOB_MATCH_AI_TIMEOUT_SECONDS=12
